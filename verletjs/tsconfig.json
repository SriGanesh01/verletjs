{
    "compilerOptions": {
        "target": "es2020",
        "module": "esnext",
        "declaration": true,
        "outDir": "./dist",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "noImplicitAny": true,
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": ["node_modules","dist","test"]
}